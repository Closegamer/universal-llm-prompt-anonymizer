{
  "name": "universal-llm-prompt-anonymizer",
  "version": "0.1.0",
  "description": "Universal LLM Prompt Anonymizer: local PII gateway for cloud LLMs, with an OpenCode plugin. Универсальный анонимизатор промптов LLM: локальный шлюз анонимизации персональных данных.",
  "type": "module",
  "license": "MIT",
  "author": "Closegamer",
  "homepage": "https://github.com/Closegamer/universal-llm-prompt-anonymizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Closegamer/universal-llm-prompt-anonymizer.git"
  },
  "bugs": {
    "url": "https://github.com/Closegamer/universal-llm-prompt-anonymizer/issues"
  },
  "keywords": [
    "pii",
    "privacy",
    "anonymization",
    "llm",
    "universal",
    "prompt-anonymizer",
    "opencode",
    "opencode-plugin",
    "ner",
    "proxy",
    "russian",
    "bilingual"
  ],
  "bin": {
    "prompt-anonymizer": "./src/cli.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "src",
    "assets",
    "README.md",
    "README.ru.md",
    "INSTALL.md",
    "INSTALL.ru.md",
    "LICENSE",
    "anonymizer.config.example.json"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "serve": "node src/cli.js serve",
    "install-opencode": "node src/cli.js install",
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@opencode/plugin": "2.2.0"
  },
  "engines": {
    "node": ">=22.15"
  }
}
